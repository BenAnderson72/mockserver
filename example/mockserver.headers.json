{
  "$schema": "https://opensource.trymagic.xyz/schemas/mockserver.schema.json",
  "server": {
    "port": 5000,
    "api_prefix": "/api/v1",
    "cors": { "enabled": true }
  },
  "routes": [
    {
      "name": "Get Users by header_param X-User-ID",
      "tag": "Users",
      "method": "GET",
      "path": "/users",
      "header_params": {
        "X-User-ID": "id"
      },
      "cases": [
        {
          "when": "request.headers.X-User-ID == '500'",
          "then": {
            "file": "mocks/503.json"
          }
        }
      ],
      "mock": {
        "file": "mocks/users.json",
        "status": 200
      }
    },
    {
      "name": "Get User By path_param ID",
      "tag": "Users",
      "method": "GET",
      "path": "/users/{id}",
      "path_params": {
        "id": {
          "type": "integer",
          "description": "Kullanıcı ID",
          "required": true
        }
      },
      "mock": {
        "file": "mocks/users.json"
      }
    }
    
  ]
}